# Copy this file to .env and adjust the values
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/srb
ADMIN_KEY=change-me-admin-key

# JWT signing secret: any long random string (never commit the real one)
JWT_SECRET=change-me-to-a-long-random-secret

# Account created by: npm run seed:admin
ADMIN_EMAIL=admin@srb.edu.pk
ADMIN_PASSWORD=change-me-admin-password
