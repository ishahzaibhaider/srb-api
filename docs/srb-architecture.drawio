y x="0" y="120" width="340" height="30" as="geometry"></mxGeometry></mxCell><mxCell id="er-v67" value="UK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="er-v66"><mxGeometry x="0" y="0" width="60" height="30" as="geometry"><mxRectangle width="60" height="30" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="er-v68" value="email : String (unique)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="er-v66"><mxGeometry x="60" y="0" width="280" height="30" as="geometry"><mxRectangle width="280" height="30" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="er-e69" value="has&lt;br&gt;1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;endFill=0;startFill=0;labelBackgroundColor=#ffffff;startSize=12;endSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="er-v6" target="er-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er-e70" value="is booked in&lt;br&gt;1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;endFill=0;startFill=0;labelBackgroundColor=#ffffff;startSize=12;endSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="er-v19" target="er-v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er-e71" value="makes&lt;br&gt;1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;rounded=0;endFill=0;startFill=0;labelBackgroundColor=#ffffff;startSize=12;endSize=12;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="er-v60" target="er-v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="er-v72" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = primary key · FK = foreign key&lt;br&gt;UK = unique field · UQ = compound unique index&lt;br&gt;Crow's foot: ┼ exactly one · ○&amp;lt; zero or many" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="380" height="110" as="geometry"></mxGeometry></mxCell><mxCell id="er-v73" value="&lt;b&gt;Capacity rule&lt;/b&gt;&lt;br&gt;A Slot has at most &lt;i&gt;seats&lt;/i&gt; Bookings, i.e. the invariant &lt;b&gt;booked ≤ seats&lt;/b&gt; always holds. It is enforced atomically when booking: Slot.findOneAndUpdate({ _id, $expr: { $lt: ['$booked', '$seats'] } }, { $inc: { booked: 1 } })." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="440" height="130" as="geometry"></mxGeometry></mxCell><mxCell id="er-v74" value="&lt;b&gt;Associative entity&lt;/b&gt;&lt;br&gt;Booking resolves the many-to-many relationship &lt;b&gt;Student M : N Slot&lt;/b&gt; (a student books many slots; a slot is booked by many students). unique (regNo, slot) prevents a student booking the same slot twice." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="440" height="130" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="seq" name="Sequence: Book a slot"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq-v1" value="&lt;b&gt;Sequence: Book a slot&lt;/b&gt; – Study Room Booking Service – Syed Shahzaib Haider Rizvi (FA23-BAI-05